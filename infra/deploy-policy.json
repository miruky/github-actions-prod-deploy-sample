{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "DeployOneFunction",
      "Effect": "Allow",
      "Action": [
        "lambda:GetAlias",
        "lambda:GetFunction",
        "lambda:GetFunctionConfiguration",
        "lambda:ListVersionsByFunction",
        "lambda:UpdateFunctionCode",
        "lambda:PublishVersion",
        "lambda:UpdateAlias",
        "lambda:InvokeFunction"
      ],
      "Resource": ["__FN_ARN__", "__FN_ARN__:*"]
    }
  ]
}
